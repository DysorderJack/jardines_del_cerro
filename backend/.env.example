# =========================================================================
# Variables de Entorno — Torre Residencial Jardines del Cerro IV
# =========================================================================

# Entorno de Ejecución
ENV=development
PORT=8000
HOST=0.0.0.0

# Base de Datos (SQLite local por defecto; en Render/Railway usa DATABASE_URL de PostgreSQL)
DATABASE_URL=sqlite:///./jardines_del_cerro.db

# Google Gemini API Key (Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Credenciales de PayPal Developer (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=sb-dummy-client-id-for-preview
PAYPAL_CLIENT_SECRET=

# Notificaciones por Correo Electrónico SMTP (Gmail, Brevo, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-clave-de-aplicacion
SMTP_FROM=notificaciones@jardinesdelcerro.com
FRONTEND_URL=https://jardines-del-cerro.vercel.app

# Facturación Electrónica DGII (e-CF - Ley 32-23)
# Coloca aquí la API Key de tu proveedor de facturación electrónica
ECF_API_KEY=ecf_live_6dfa18e5b57b39c212518f6ac148e3f7538ab343d93007a23542f2f402d9b5cc
ECF_API_BASE_URL=https://aura.nexo.com.do/api
ECF_RNC_EMISOR=132-45678-9
ECF_RAZON_SOCIAL_EMISOR=Torre Residencial Jardines del Cerro IV, S.R.L.
ECF_ENVIRONMENT=live
ECF_DEFAULT_EXCHANGE_RATE=60.50

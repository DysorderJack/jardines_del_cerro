# =========================================================================
# Variables de Entorno — Torre Residencial Jardines del Cerro IV
# =========================================================================

# Entorno de Ejecución
ENV=development
PORT=8000
HOST=0.0.0.0

# Base de Datos (SQLite local por defecto; en Render/Railway usa DATABASE_URL de PostgreSQL)
DATABASE_URL=sqlite:///./jardines_del_cerro.db

# Google Gemini API Key (Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Credenciales de PayPal Developer (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=sb-dummy-client-id-for-preview
PAYPAL_CLIENT_SECRET=
